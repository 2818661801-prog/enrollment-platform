{
  "openapi": "3.0.0",
  "info": {
    "title": "获取班级-类别关联列表",
    "version": "1.0.0",
    "description": "获取全部班级和类别的关联关系（class_category 中间表），供低代码平台同步用"
  },
  "servers": [
    { "url": "https://***REMOVED***", "description": "外网生产环境" }
  ],
  "paths": {
    "/api/admin/classCategory": {
      "get": {
        "summary": "获取全部班级-类别关联",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code":    { "type": "integer" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id":         { "type": "integer",  "description": "关联记录主键" },
                          "classId":    { "type": "integer",  "description": "班级ID" },
                          "categoryId": { "type": "integer",  "description": "类别ID" },
                          "createdAt":  { "type": "string",   "description": "创建时间（可为空）" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
