{
  "openapi": "3.0.0",
  "info": {
    "title": "管理员登录",
    "version": "1.0.0",
    "description": "管理员账号密码登录，返回 JWT token"
  },
  "servers": [
    { "url": "https://***REMOVED***", "description": "外网生产环境" }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "管理员登录",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "description": "管理员用户名" },
                  "password": { "type": "string", "description": "管理员密码" }
                },
                "required": ["username", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": { "type": "string", "description": "JWT token" },
                        "username": { "type": "string", "description": "用户名" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
