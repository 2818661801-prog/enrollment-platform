{
  "openapi": "3.0.0",
  "info": {
    "title": "报名记录全量查询",
    "version": "1.0.2",
    "description": "全量查询所有报名记录（不分页），解决低代码平台分页响应解析问题。enrollmentYear 字段于 2026-07-19 新增"
  },
  "servers": [
    { "url": "https://***REMOVED***", "description": "外网生产环境" }
  ],
  "paths": {
    "/api/admin/applications/all": {
      "get": {
        "summary": "报名记录全量查询（不分页）",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code":    { "type": "integer", "description": "状态码（200=成功）" },
                    "message": { "type": "string",  "description": "状态信息" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id":               { "type": "integer",  "description": "外网报名记录ID" },
                          "name":             { "type": "string",   "description": "学生姓名" },
                          "idCard":           { "type": "string",   "description": "脱敏身份证（中间8位***）" },
                          "idCardRaw":        { "type": "string",   "description": "原始身份证号（低代码同步主键）" },
                          "gender":           { "type": "string",   "description": "性别" },
                          "phone":            { "type": "string",   "description": "联系电话" },
                          "hasPhysics":       { "type": "string",   "description": "是否选考物理（是/否）" },
                          "hasEnglish":       { "type": "string",   "description": "是否选考英语（是/否）" },
                          "classId":          { "type": "integer",  "description": "外网班级ID" },
                          "className":        { "type": "string",   "description": "班级名称" },
                          "appliedCategory":  { "type": "string",   "description": "报考类别" },
                          "status":           { "type": "string",   "description": "状态（'1'=已报名,'2'=已撤回,'3'=已录取,'4'=未录取），注意是string类型" },
                          "applyTime":        { "type": "string",   "description": "报名时间（ISO格式，如2026-07-19T10:30:00）" },
                          "auditComment":     { "type": "string",   "description": "审核意见（null=未审核）" },
                          "classPeriods":     { "type": "string",   "description": "废弃字段（null）" },
                          "round":            { "type": "integer",  "description": "报名轮次（1=第一轮,2=第二轮）" },
                          "isDeleted":        { "type": "integer",  "description": "软删除标记（0=正常）" },
                          "innerId":          { "type": "integer",  "description": "内网班级ID（外网classes.outer_id）" },
                          "enrollmentYear":   { "type": "integer",  "description": "报名年级（2026=2026年,2027=2027年），外网后端自动写入，2026-07-19之前的旧数据可能为null" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
